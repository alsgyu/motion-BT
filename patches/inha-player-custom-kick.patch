+int RobotClient::publishCustomKickGoalImpl(double ballX, double ballY, double targetAngleDeg)
+{
+    if (!customKickGoalPublisher) {
+        if (!brain || !brain->config || !brain->config->customKickEnable) {
+            return -1;
+        }
+        customKickGoalTopic = brain->config->customKickGoalTopic;
+        customKickGoalPublisher =
+            brain->create_publisher<geometry_msgs::msg::Pose2D>(customKickGoalTopic, 10);
+        std::cout << "RobotClient: created custom kick goal publisher on "
+                  << customKickGoalTopic << std::endl;
+    }
+
+    auto msg = geometry_msgs::msg::Pose2D();
+    msg.x = ballX;
+    msg.y = ballY;
+    msg.theta = targetAngleDeg;
+    customKickGoalPublisher->publish(msg);
+    return 0;
+}
+
+int RobotClient::publishCustomKickGoal(double ballX, double ballY, double targetAngleDeg)
+{
+    if (!brain || !brain->config || !brain->config->customKickEnable) {
+        return -1;
+    }
+    int ret = publishCustomKickGoalImpl(ballX, ballY, targetAngleDeg);
+    std::cout << "RobotClient::publishCustomKickGoal ball=("
+              << ballX << ", " << ballY << ") "
+              << "target_angle=" << targetAngleDeg << "deg"
+              << " ret=" << ret << std::endl;
+    return ret;
+}
+
 int RobotClient::stopMotionForModeChange()
