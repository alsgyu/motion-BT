+bool RLVisionKick::hasFreshBallAfterSoccerConfirm() const
+{
+    if (!brain->data->ballDetected) {
+        return false;
+    }
+    if (brain->data->ball.timePoint.nanoseconds() == 0) {
+        return true;
+    }
+    if (brain->msecsSince(brain->data->ball.timePoint) > 500.0) {
+        return false;
+    }
+    if (_soccerModeConfirmedTime.nanoseconds() == 0) {
+        return true;
+    }
+    return (brain->data->ball.timePoint - _soccerModeConfirmedTime).nanoseconds() >= -200000000;
+}
+
+void RLVisionKick::resetSoccerHeadReacquire()
+{
+    _lastHeadReacquireTime = rclcpp::Time(0, 0, RCL_ROS_TIME);
+    _headReacquireIndex = 0;
+    _headReacquireTimeoutLogged = false;
+}
+
+void RLVisionKick::stepSoccerHeadReacquire()
+{
+    if (hasFreshBallAfterSoccerConfirm()) {
+        double pitch = brain->data->ball.pitchToRobot;
+        double yaw = brain->data->ball.yawToRobot;
+        if (!std::isfinite(pitch) || pitch <= 0.0) pitch = 0.7;
+        if (!std::isfinite(yaw)) yaw = 0.0;
+        brain->client->moveHead(std::max(pitch, 0.55), yaw);
+        return;
+    }
+
+    const bool shouldSend =
+        _lastHeadReacquireTime.nanoseconds() == 0 ||
+        brain->msecsSince(_lastHeadReacquireTime) >= _soccerHeadScanIntervalMsec;
+    if (!shouldSend) {
+        return;
+    }
+
+    constexpr double scanSequence[][2] = {
+        {0.70, 0.00},
+        {0.65, 0.40},
+        {0.65, 0.00},
+        {0.65, -0.40},
+        {0.35, -0.40},
+        {0.35, 0.00},
+        {0.35, 0.40},
+    };
+    constexpr int scanSequenceSize = sizeof(scanSequence) / sizeof(scanSequence[0]);
+    brain->client->moveHead(
+        scanSequence[_headReacquireIndex][0],
+        scanSequence[_headReacquireIndex][1]);
+    _headReacquireIndex = (_headReacquireIndex + 1) % scanSequenceSize;
+    _lastHeadReacquireTime = brain->get_clock()->now();
+}
