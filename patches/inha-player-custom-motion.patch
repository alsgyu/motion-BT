+int RobotClient::publishCustomMotionVelocity(double x, double y, double theta)
+{
+    if (!customMotionPublisher) {
+        configureCustomMotionPublisher();
+    }
+
+    if (!customMotionPublisher) {
+        return -1;
+    }
+
+    if (brain->config && brain->config->customMotionRequireSubscriber &&
+        customMotionPublisher->get_subscription_count() == 0) {
+        brain->log->log("RobotClient/custom_motion",
+                        rerun::TextLog("cmd_vel subscriber missing"));
+        return -1;
+    }
+
+    geometry_msgs::msg::Twist msg;
+    msg.linear.x = x;
+    msg.linear.y = y;
+    msg.angular.z = theta;
+    customMotionPublisher->publish(msg);
+    return 0;
+}
+
+int RobotClient::publishCustomMotionHead(double pitch, double yaw)
+{
+    if (!customMotionHeadPublisher) {
+        configureCustomMotionPublisher();
+    }
+
+    if (!customMotionHeadPublisher) {
+        return -1;
+    }
+
+    sensor_msgs::msg::JointState msg;
+    msg.header.stamp = brain->get_clock()->now();
+    msg.name = {"AAHead_yaw", "Head_pitch"};
+    msg.position = {yaw, pitch};
+    customMotionHeadPublisher->publish(msg);
+    return 0;
+}
