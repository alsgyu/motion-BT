+
+int RobotClient::stopMotionForModeChange()
+{
+    const double startVx = _vx;
+    const double startVy = _vy;
+    const double startVtheta = _vtheta;
+    const bool shouldRamp =
+        std::fabs(startVx) > 1e-3 ||
+        std::fabs(startVy) > 1e-3 ||
+        std::fabs(startVtheta) > 1e-3;
+    constexpr double scales[] = {0.6, 0.3, 0.0};
+    int ret = 0;
+
+    for (double scale : scales) {
+        if (!shouldRamp && scale > 0.0) {
+            continue;
+        }
+
+        const double vx = startVx * scale;
+        const double vy = startVy * scale;
+        const double vtheta = startVtheta * scale;
+        _vx = vx;
+        _vy = vy;
+        _vtheta = vtheta;
+        _lastCmdTime = brain->get_clock()->now();
+
+        if (brain->config && brain->config->customMotionEnable) {
+            const int customRet = publishCustomMotionVelocity(vx, vy, vtheta);
+            if (ret == 0 && customRet != 0) {
+                ret = customRet;
+            }
+        }
+
+        const int sdkRet = call(booster_interface::CreateMoveMsg(vx, vy, vtheta));
+        if (ret == 0 && sdkRet != 0) {
+            ret = sdkRet;
+        }
+
+        if (shouldRamp && scale > 0.0) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(70));
+        }
+    }
+
+    return ret;
+}
+
+int RobotClient::publishCustomMotionHead(double pitch, double yaw)
+{
+    if (!customMotionHeadPublisher) {
+        configureCustomMotionPublisher();
+    }
+
+    if (!customMotionHeadPublisher) {
+        return -1;
+    }
+
+    sensor_msgs::msg::JointState msg;
+    msg.header.stamp = brain->get_clock()->now();
+    msg.name = {"AAHead_yaw", "Head_pitch"};
+    msg.position = {yaw, pitch};
+    customMotionHeadPublisher->publish(msg);
+    return 0;
+}
