+void RobotClient::configureCustomMotionPublisher()
+{
+    std::string topic = "/inha/custom_motion/cmd_vel";
+    std::string headTopic = "/inha/custom_motion/head";
+    if (brain->config && !brain->config->customMotionCmdVelTopic.empty()) {
+        topic = brain->config->customMotionCmdVelTopic;
+    }
+    if (brain->config && !brain->config->customMotionHeadTopic.empty()) {
+        headTopic = brain->config->customMotionHeadTopic;
+    }
+
+    if (!customMotionPublisher || topic != customMotionCmdVelTopic) {
+        customMotionCmdVelTopic = topic;
+        customMotionPublisher = brain->create_publisher<geometry_msgs::msg::Twist>(
+            customMotionCmdVelTopic,
+            rclcpp::QoS(1).reliable());
+        std::cout << "RobotClient::customMotion cmd_vel topic: "
+                  << customMotionCmdVelTopic << std::endl;
+    }
+
+    if (!customMotionHeadPublisher || headTopic != customMotionHeadTopic) {
+        customMotionHeadTopic = headTopic;
+        customMotionHeadPublisher = brain->create_publisher<sensor_msgs::msg::JointState>(
+            customMotionHeadTopic,
+            rclcpp::QoS(1).reliable());
+        std::cout << "RobotClient::customMotion head topic: "
+                  << customMotionHeadTopic << std::endl;
+    }
 }
 
